<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_payment_term_form_inherit_elinvoice" model="ir.ui.view">
            <field name="name">account.payment.term.form.inherit.elinvoice</field>
            <field name="model">account.payment.term</field>
            <field name="inherit_id" ref="account.view_payment_term_form" />
            <field name="arch" type="xml">
                <xpath expr="//sheet//div[@class='oe_title']" position="after">
                    <group>
                        <field name="mh_code" string="Código MH" required="1"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
